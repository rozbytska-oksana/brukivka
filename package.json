{
  "name": "brukivka",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "node scripts/run-check.mjs typecheck",
    "lint": "node scripts/run-check.mjs lint",
    "assets:prepare": "python3 scripts/prepare_legacy_assets.py && prettier --write app/data",
    "brand:prepare": "python3 scripts/prepare_brand_assets.py",
    "test": "node --test tests/*.test.mjs",
    "verify:output": "node scripts/verify-output.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "preview:static": "node scripts/static-server.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint:fix": "eslint . --fix && prettier --write . --ignore-unknown"
  },
  "dependencies": {
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "sass": "1.105.2",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
